# ============================================================
#  KR&BR backend configuration  (copy this file to ".env")
#  Do NOT commit the real .env file. Keep secrets secret.
# ============================================================

# ---------- MySQL connection ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
# A MySQL account that can CREATE the database + tables.
# You can use root for setup, or a dedicated user.
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=kr_br

# ---------- Encryption keys ----------
# These are generated automatically by:  python backend/setup.py
# (leave empty here; setup.py fills them into .env for you)
# AES-256 key, base64-url, must decode to exactly 32 bytes
AES_KEY=
# HMAC key (blind card-number lookup / dedup), base64-url
CARD_HMAC_KEY=
# Flask session/signing secret
FLASK_SECRET_KEY=

# ---------- Admin account (seeded on first setup) ----------
ADMIN_EMAIL=admin@krbr.com
# Set a strong password; if left empty, setup.py generates one and prints it.
ADMIN_PASSWORD=

# ---------- Server ----------
# Host/port the Flask API listens on. Frontend API_BASE must match.
API_HOST=127.0.0.1
API_PORT=5000
